{
  "manifest_version": 3,
  "version": "2.0.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "name": "__MSG_appName__",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "notifications",
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "media-utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:14201/*"
  ],
  "background": {
    "service_worker": "background-worker.js",
    "scripts": [
      "media-utils.js",
      "shared.js",
      "pairing.js",
      "api.js",
      "background.js"
    ],
    "preferred_environment": [
      "document",
      "service_worker"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "falcon@falcondm.app",
      "strict_min_version": "136",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "121",
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
