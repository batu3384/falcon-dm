{
  "manifest_version": 3,
  "name": "Falcon DM Sniffer",
  "version": "1.0",
  "description": "Intercepts media downloads and sends them to Falcon DM desktop app.",
  "permissions": [
    "webRequest",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
